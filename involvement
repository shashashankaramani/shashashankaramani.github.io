  <style>

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background-color: #ffffff;
      color: #1a1a1a;
    }


    /* TOP NAVIGATION */

    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 24px 8%;
      border-bottom: 1px solid #e6e6e6;
      position: sticky;
      top: 0;
      background: white;
      z-index: 100;
    }

    .nav-name {
      font-size: 20px;
      font-weight: 700;
    }

    .nav-links a {
      margin-left: 28px;
      text-decoration: none;
      color: #1a1a1a;
      font-size: 15px;
    }

    .nav-links a:hover {
      color: #777;
    }


    /* PAGE HEADER */

    .page-header {
      padding: 90px 8% 45px;
      max-width: 1100px;
    }

    .page-header h1 {
      font-size: 56px;
      margin: 0 0 20px;
      letter-spacing: -1px;
    }

    .page-header p {
      font-size: 19px;
      line-height: 1.7;
      color: #555;
      max-width: 800px;
    }


    /* JUMP NAVIGATION */

    .involvement-nav {
      padding: 10px 8% 70px;
    }

    .involvement-nav-inner {
      max-width: 1150px;
      margin: 0 auto;

      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .involvement-nav a {
      text-decoration: none;
      color: #1a1a1a;
    }

    .involvement-nav-card {
      border: 1px solid #dddddd;
      border-radius: 12px;
      padding: 24px 20px;
      background-color: #ffffff;
      min-height: 150px;
      transition: 0.2s;
    }

    .involvement-nav-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }

    .involvement-nav-icon {
      font-size: 30px;
      margin-bottom: 14px;
    }

    .involvement-nav-title {
      font-size: 17px;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .involvement-nav-subtitle {
      font-size: 14px;
      color: #666;
      line-height: 1.4;
    }


    /* SECTION */

    .involvement-section {
      padding: 80px 8%;
      border-top: 1px solid #eeeeee;
      scroll-margin-top: 100px;
    }

    .involvement-inner {
      max-width: 1150px;
      margin: 0 auto;
    }

    .involvement-header {
      display: flex;
      justify-content: space-between;
      gap: 30px;
      margin-bottom: 40px;
      flex-wrap: wrap;
    }

    .involvement-title h2 {
      font-size: 38px;
      margin: 0 0 10px;
    }

    .involvement-title h3 {
      font-size: 20px;
      font-weight: 500;
      color: #555;
      margin: 0;
    }

    .involvement-date {
      color: #777;
      font-size: 16px;
      padding-top: 8px;
    }

    .overview {
      max-width: 850px;
      font-size: 18px;
      line-height: 1.7;
      color: #444;
      margin-bottom: 45px;
    }


    /* DETAIL CARDS */

    .details {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 40px;
    }

    .detail-card {
      border-top: 2px solid #1a1a1a;
      padding-top: 18px;
    }

    .detail-card h4 {
      font-size: 20px;
      margin: 0 0 10px;
    }

    .detail-card p {
      font-size: 15px;
      line-height: 1.6;
      color: #666;
      margin: 0;
    }


    /* MEDIA PLACEHOLDER */

    .media-placeholder {
      margin-top: 50px;
      min-height: 280px;
      border: 1px dashed #bcbcbc;
      border-radius: 12px;
      background: #f7f7f7;

      display: flex;
      align-items: center;
      justify-content: center;

      text-align: center;
      color: #888;
      padding: 30px;
    }


    /* FOOTER */

    footer {
      padding: 45px 8%;
      border-top: 1px solid #eeeeee;
      color: #777;
      font-size: 14px;
    }


    /* MOBILE */

    @media (max-width: 850px) {

      nav {
        flex-direction: column;
        align-items: flex-start;
      }

      .nav-links {
        margin-top: 14px;
      }

      .nav-links a {
        margin-left: 0;
        margin-right: 18px;
      }

      .page-header h1 {
        font-size: 42px;
      }

      .involvement-nav-inner {
        grid-template-columns: 1fr;
      }

      .details {
        grid-template-columns: 1fr;
      }

    }

  </style>

</head>


